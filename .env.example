# Browser-safe build variables. VITE_* values are visible to the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SHOPIFY_ENABLED=false

# Render server-side variables. Never expose these through VITE_*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
TOMTOM_API_KEY=YOUR_SERVER_TOMTOM_KEY

# Shopify remains optional until merchant/app access is available.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# Render generates this automatically in render.yaml; you can also set it manually.
INTERNAL_SYNC_SECRET=YOUR_RANDOM_INTERNAL_SYNC_SECRET
APP_BASE_URL=https://YOUR-SERVICE.onrender.com
